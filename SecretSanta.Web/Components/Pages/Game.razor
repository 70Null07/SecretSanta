@page "/games/{GameId:int}"
@using SecretSanta.Web.Localization
@using SecretSanta.Web.Models
@inject IStringLocalizer<SharedResource> Localizer
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JS
@inject NavigationManager Nav
<PageTitle>@(game?.Name??Localizer["Game"])</PageTitle>
<section class="page-section game-page"><div class="shell">
 <a class="back-link" href="/mygames">← @Localizer["BackToGames"]</a>
 @if(loading){<div class="loading-state"><span class="spinner"></span><p>@Localizer["LoadingGame"]</p></div>}
 else if(!string.IsNullOrEmpty(error)){<div class="empty-state"><h1>@Localizer["GameUnavailable"]</h1><p>@error</p><a class="btn btn-secondary" href="/mygames">@Localizer["BackToGames"]</a></div>}
 else if(game is not null){
  <header class="game-heading"><div><div class="status-pill @(game.IsDrawn?"status-done":"status-open")">@(game.IsDrawn?Localizer["DrawCompleted"]:Localizer["CollectingParticipants"])</div><h1>@game.Name</h1><p>@Localizer["GameSummary",game.Participants.Count,game.GiftCost]</p></div>@if(isCreator&&!game.IsDrawn){<button class="btn btn-primary" @onclick="()=>showDraw=true" disabled="@(game.Participants.Count<2)">@Localizer["StartDraw"]</button>}</header>
  @if(!string.IsNullOrEmpty(notice)){<div class="notice @(noticeError?"notice-error":"notice-success")" role="status">@notice</div>}
  <div class="game-layout"><div class="game-main">
   @if(game.IsDrawn){<section class="recipient-card"><p class="eyebrow">@Localizer["YourRecipient"]</p><div class="recipient-reveal"><span class="seal-small">S</span><div><small>@Localizer["PrepareGiftFor"]</small><h2>@assignment.RecieverName</h2></div></div>@if(assignment.RecieverGifts.Count>0){<h3>@Localizer["RecipientWishes"]</h3><ul>@foreach(var gift in assignment.RecieverGifts){<li><span>✦</span><div><strong>@gift.GiftName</strong><small>@gift.DeliveryMethod</small></div></li>}</ul>}else{<p class="muted">@Localizer["RecipientNoWishes"]</p>}</section>}
   <section class="panel"><div class="panel-heading"><div><p class="eyebrow">@Localizer["GiftIdeas"]</p><h2>@Localizer["MyWishes"]</h2></div><span>@myGifts.Count</span></div><p class="muted">@Localizer["WishesHelp"]</p>
    <EditForm Model="giftForm" OnValidSubmit="AddGiftAsync" FormName="gift-form"><DataAnnotationsValidator/><div class="gift-form"><div class="field"><label for="gift-name">@Localizer["GiftName"]</label><InputText id="gift-name" @bind-Value="giftForm.GiftName" maxlength="300" placeholder="@Localizer["GiftNameExample"]"/><ValidationMessage For="()=>giftForm.GiftName"/></div><div class="field"><label for="delivery">@Localizer["DeliveryMethod"]</label><InputText id="delivery" @bind-Value="giftForm.DeliveryMethod" maxlength="300" placeholder="@Localizer["DeliveryExample"]"/><ValidationMessage For="()=>giftForm.DeliveryMethod"/></div><button class="btn btn-primary" disabled="@savingGift">@Localizer["Add"]</button></div></EditForm>
    @if(myGifts.Count==0){<div class="inline-empty">@Localizer["NoWishesYet"]</div>}else{<ul class="wish-list">@foreach(var gift in myGifts){<li><div><strong>@gift.GiftName</strong><small>@gift.DeliveryMethod</small></div><button class="icon-button" @onclick="()=>DeleteGiftAsync(gift.UserGiftId)" aria-label="@Localizer["DeleteWish",gift.GiftName]">×</button></li>}</ul>}
   </section>
  </div><aside class="game-sidebar"><section class="panel"><div class="panel-heading"><div><p class="eyebrow">@Localizer["TheCompany"]</p><h2>@Localizer["Participants"]</h2></div><span>@game.Participants.Count</span></div><ul class="participant-list">@foreach(var participant in game.Participants){<li><span class="avatar">@participant[..1].ToUpper()</span><strong>@participant</strong>@if(participant==currentUser){<small>@Localizer["You"]</small>}</li>}</ul></section>
   @if(isCreator){<section class="panel invite-panel"><p class="eyebrow">@Localizer["OrganizerTools"]</p><h2>@Localizer["InviteParticipants"]</h2><p>@Localizer["InviteHelp"]</p>@if(string.IsNullOrEmpty(inviteLink)){<button class="btn btn-secondary btn-block" @onclick="CreateInviteAsync" disabled="@inviteBusy">@(inviteBusy?Localizer["PleaseWait"]:Localizer["CreateInviteLink"])</button>}else{<label for="invite-link">@Localizer["InvitationLinkLabel"]</label><div class="copy-field"><input id="invite-link" readonly value="@inviteLink"/><button @onclick="CopyInviteAsync">@(copied?Localizer["Copied"]:Localizer["Copy"])</button></div><small>@Localizer["ManualCopyHint"]</small>}</section>}
  </aside></div>
 }
</div></section>
@if(showDraw){<div class="dialog-backdrop" @onpointerdown="()=>showDraw=false"><section class="dialog" role="alertdialog" aria-modal="true" @onpointerdown:stopPropagation><button class="icon-button dialog-close" @onclick="()=>showDraw=false">×</button><div class="draw-icon">✦</div><h2>@Localizer["ConfirmDrawTitle"]</h2><p>@Localizer["ConfirmDrawText"]</p><div class="notice notice-warn">@Localizer["DrawCannotUndo"]</div><div class="dialog-actions"><button class="btn btn-secondary" @onclick="()=>showDraw=false">@Localizer["Cancel"]</button><button class="btn btn-primary" @onclick="StartDrawAsync" disabled="@drawing">@(drawing?Localizer["Drawing"]:Localizer["ConfirmDraw"])</button></div></section></div>}
@code {
 [Parameter] public int GameId{get;set;} private GameListDto? game;private List<UserGiftDto> myGifts=[];private ReceiverGiftDto assignment=new();private GiftForm giftForm=new();private string token="",error="",notice="",inviteLink="",currentUser="";private int userId;private bool loading=true,isCreator,savingGift,inviteBusy,copied,showDraw,drawing,noticeError;
 protected override async Task OnAfterRenderAsync(bool first){if(!first)return;try{token=await JS.InvokeAsync<string?>("localStorage.getItem","authToken")??"";currentUser=await JS.InvokeAsync<string?>("localStorage.getItem","username")??"";int.TryParse(await JS.InvokeAsync<string?>("localStorage.getItem","userId"),out userId);if(string.IsNullOrEmpty(token)){error=Localizer["unauthorized"];}else await LoadAsync();}catch{error=Localizer["ConnectionError"];}loading=false;StateHasChanged();}
 private HttpClient Client(){var c=ClientFactory.CreateClient("api");c.DefaultRequestHeaders.Authorization=new("Bearer",token);return c;}
 private async Task LoadAsync(){try{var all=await Client().GetFromJsonAsync<List<GameListDto>>("api/games/user")??[];game=all.FirstOrDefault(x=>x.GameId==GameId);if(game is null){error=Localizer["game_not_found"];return;}isCreator=game.CreatorId==userId;myGifts=await Client().GetFromJsonAsync<List<UserGiftDto>>($"api/gifts/{GameId}/gifts")??[];if(game.IsDrawn)assignment=await Client().GetFromJsonAsync<ReceiverGiftDto>($"api/assignments/giver/{GameId}")??new();}catch{error=Localizer["ConnectionError"];}}
 private async Task AddGiftAsync(){if(savingGift)return;savingGift=true;try{var r=await Client().PostAsJsonAsync($"api/gifts/{GameId}/gifts",giftForm);if(r.IsSuccessStatusCode){giftForm=new();myGifts=await Client().GetFromJsonAsync<List<UserGiftDto>>($"api/gifts/{GameId}/gifts")??[];notice=Localizer["WishSaved"];noticeError=false;}else await Error(r);}finally{savingGift=false;}}
 private async Task DeleteGiftAsync(int id){var r=await Client().DeleteAsync($"api/gifts/{GameId}/gifts/{id}");if(r.IsSuccessStatusCode)myGifts.RemoveAll(x=>x.UserGiftId==id);else await Error(r);}
 private async Task CreateInviteAsync(){inviteBusy=true;var r=await Client().PostAsync($"api/games/{GameId}/invite",null);if(r.IsSuccessStatusCode){var data=await r.Content.ReadFromJsonAsync<InviteResult>();if(data is not null)inviteLink=$"{Nav.BaseUri}mygames?inviteToken={Uri.EscapeDataString(data.InviteToken)}";}else await Error(r);inviteBusy=false;}
 private async Task CopyInviteAsync(){try{copied=await JS.InvokeAsync<bool>("secretSanta.copyText",inviteLink);}catch{copied=false;}notice=copied?Localizer["InviteCopied"]:Localizer["ManualCopyHint"];noticeError=false;}
 private async Task StartDrawAsync(){drawing=true;var r=await Client().PostAsync($"api/assignments/draw/{GameId}",null);if(r.IsSuccessStatusCode){showDraw=false;await LoadAsync();notice=Localizer["DrawSuccess"];noticeError=false;}else await Error(r);drawing=false;}
 private async Task Error(HttpResponseMessage r){notice=Localizer[await ApiErrorReader.ReadCodeAsync(r)];noticeError=true;}
 private sealed class GiftForm{[System.ComponentModel.DataAnnotations.Required,System.ComponentModel.DataAnnotations.MaxLength(300)]public string GiftName{get;set;}="";[System.ComponentModel.DataAnnotations.Required,System.ComponentModel.DataAnnotations.MaxLength(300)]public string DeliveryMethod{get;set;}="";}
}
