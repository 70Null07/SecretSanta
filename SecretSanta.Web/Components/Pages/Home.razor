@page "/"
@using SecretSanta.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Home"]</PageTitle>
<div class="hero">
    <div class="snowblock"></div>
    <div class="content">
        <h2>@Localizer["HeroTitle"]</h2>
        <p>@Localizer["HeroSubtitle"]</p>
    </div>
</div>

<div class="container">
    <h3 style="margin-top:20px">@Localizer["FaqTitle"]</h3>
    <div class="faq-item">
        <div class="faq-question"><strong>@Localizer["FaqJoinQ"]</strong></div>
        <div class="faq-answer">@Localizer["FaqJoinA"]</div>
    </div>
    <div class="faq-item">
        <div class="faq-question"><strong>@Localizer["FaqAnonymousQ"]</strong></div>
        <div class="faq-answer">@Localizer["FaqAnonymousA"]</div>
    </div>
    <div class="faq-item">
        <div class="faq-question"><strong>@Localizer["FaqDrawQ"]</strong></div>
        <div class="faq-answer">@Localizer["FaqDrawA"]</div>
    </div>
</div>
