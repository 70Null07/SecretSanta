@page "/Error"
@using System.Diagnostics
@using SecretSanta.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["ErrorTitle"]</PageTitle>
<h1 class="text-danger">@Localizer["ErrorHeading"]</h1>
<h2 class="text-danger">@Localizer["ErrorDescription"]</h2>

@if (ShowRequestId)
{
    <p><strong>@Localizer["RequestId"]</strong> <code>@requestId</code></p>
}

<h3>@Localizer["DevelopmentMode"]</h3>
<p>@Localizer["DevelopmentInfo"]</p>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    private string? requestId;
    private bool ShowRequestId => !string.IsNullOrEmpty(requestId);
    protected override void OnInitialized() => requestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
