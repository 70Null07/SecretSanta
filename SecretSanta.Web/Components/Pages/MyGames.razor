@page "/mygames"
@using SecretSanta.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer
<PageTitle>@Localizer["MyGames"]</PageTitle>
<div class="hero">
    <div class="snowblock"></div>
    <div class="content">
        <h2>@Localizer["HeroTitle"]</h2>
        <p>@Localizer["HeroSubtitle"]</p>
    </div>
</div>

<div class="container">
    @if (loading)
    {
        <p>@Localizer["Loading"]</p>
    }
    else if (!isLoggedIn)
    {
        <p>@Localizer["SignInToSeeGames"]</p>
    }
    else
    {
        @if (games?.Any() != true)
        {
            <p>@Localizer["NoGames"]</p>
        }
        else
        {
            <ul class="games-ul">
                @foreach (var game in games)
                {
                    <li class="games-li" @onclick="() => OpenGameModal(game)">
                        @game.Name (@game.CreatedAt.ToString("d", System.Globalization.CultureInfo.CurrentCulture))
                        — @UiText.ParticipantCount(Localizer, game.Participants.Count) — @Localizer["GiftCost", game.GiftCost]
                        @if (game.IsDrawn)
                        {
                            <span style="color:green;"> @Localizer["DrawCompletedParenthetical"]</span>
                        }
                        @if (@game.CreatorId == userId)
                        {
                            <span> — @Localizer["Creator"]</span>
                        }
                        else
                        {
                            <span> — @Localizer["Participant"]</span>
                        }
                    </li>
                }
            </ul>
        }
        <div class="header-bar right" style="display:flex;justify-content:flex-end;">
            <button @onclick="ToggleCreateGameModal">@Localizer["CreateGame"]</button>
        </div>
    }
</div>

@if (showCreateGameModal)
{
    <div class="modal-backdrop" @onclick="ToggleCreateGameModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h3>@Localizer["CreateNewGame"]</h3>
            <div style="display:list-item;">
                <div style="margin-bottom:5px;">
                    <label>@Localizer["GameName"]</label>
                    <input @bind="newGameName" />
                </div>
                <div>
                    <label>@Localizer["GiftCostUpTo"]</label>
                    <input @bind="giftCost" />
                </div>
            </div>
            <div class="header-bar right" style="margin-top:10px;display:block;">
                <button @onclick="CreateGameAsync">@Localizer["Create"]</button>
                <button @onclick="ToggleCreateGameModal">@Localizer["Cancel"]</button>
            </div>
        </div>
    </div>
}

@if (selectedGame != null)
{
    <div class="modal-backdrop" @onclick="CloseGameModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h3>@selectedGame.Name</h3>

            <p>@Localizer["Participants"]</p>
            <ol style="height: 150px;overflow-y:scroll;">
                @foreach (var participant in selectedGame.Participants)
                {
                    <li>@participant</li>
                }
            </ol>
            <hr />
            <p>@Localizer["DrawStatus", selectedGame.IsDrawn ? Localizer["Completed"] : Localizer["NotCompleted"]]</p>
            @if (!selectedGame.IsDrawn)
            {
                <h4>@Localizer["WishesForSanta"]</h4>
                <span contenteditable="true"
                      style="display: inline-block;
                             border: solid 1px black;max-width: 550px">
                </span>
                <div class="header-bar buttons" style="display:flex;justify-content:center">
                    <button>@Localizer["Add"]</button>
                </div>
            }
            else
            {
                <p>@Localizer["Recipient", assgGifts.RecieverName]</p>
                @foreach (var assg in assgGifts.RecieverGifts)
                {
                    <p style="margin-left:1.5em;">@assg.GiftName — @assg.DeliveryMethod</p>
                }
            }
            <h4>@Localizer["MyWishes"]</h4>
            <ul>
                @foreach (var gift in myGifts)
                {
                    <li style="display:flex;margin-bottom:0.5em;">
                        <div style="margin-right:1.5em;">
                            @gift.GiftName — @gift.DeliveryMethod
                        </div>

                        <button class="blue-button" @onclick="() => DeleteGiftAsync(gift.UserGiftId)"
                                style="margin-left:auto; color:white;">
                            ✖
                        </button>
                    </li>
                }
            </ul>

            <div style="margin-top:10px">
                <input placeholder="@Localizer["GiftNamePlaceholder"]" @bind="newGiftName" />
                <input placeholder="@Localizer["DeliveryMethodPlaceholder"]" @bind="newDeliveryMethod" />
                <button class="blue-button" @onclick="AddGiftAsync">@Localizer["Add"]</button>
            </div>
            @if (isCreator)
            {
                <div class="header-bar buttons">
                    @if (!selectedGame.IsDrawn)
                    {
                        <button @onclick="InviteParticipants">@Localizer["InviteParticipants"]</button>
                        <button style="margin:5px;" @onclick="StartDraw">@Localizer["StartDraw"]</button>
                    }
                </div>
            }
            <div class="header-bar" style="display:flex;justify-content:center">
              <button @onclick="CloseGameModal">@Localizer["Close"]</button>
            </div>
        </div>
    </div>
}
