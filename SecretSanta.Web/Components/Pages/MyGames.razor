@page "/mygames"
<div class="hero">
    <div class="snowblock"></div>
    <div class="content">
        <h2>🎅 Тайный Санта не просто игра — это магия зимы! ❄️</h2>
        <p>Дарите радость, сюрпризы и тёплые эмоции друзьям!</p>
    </div>
</div>

<div class="container">
    @if (loading)
    {
        <p>Загрузка...</p>
    }
    else if (!isLoggedIn)
    {
        <p>Пожалуйста, войдите, чтобы видеть свои игры.</p>
    }
    else
    {
        @if (games?.Any() != true)
        {
            <p>У вас пока нет игр.</p>
        }
        else
        {
            <ul class="games-ul">
                @foreach (var game in games)
                {
                    <li class="games-li" @onclick="() => OpenGameModal(game)">
                        @game.Name (@game.CreatedAt.ToShortDateString())
                        — участников: @game.Participants.Count — стоимость подарка до @game.GiftCost
                        @if (game.IsDrawn)
                        {
                            <span style="color:green;"> (Жеребьёвка проведена)</span>
                        }
                        @if (@game.CreatorId == userId)
                        {
                            <span> — Создатель</span>
                        }
                        else
                        {
                            <span> — Участник</span>
                        }
                    </li>
                }
            </ul>
        }
        <div class="header-bar right" style="display:flex;justify-content:flex-end;">
            <button @onclick="ToggleCreateGameModal">Создать игру</button>
        </div>
    }
</div>

@if (showCreateGameModal)
{
    <div class="modal-backdrop" @onclick="ToggleCreateGameModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h3>Создать новую игру</h3>
            <div style="display:list-item;">
                <div style="margin-bottom:5px;">
                    <label>Название игры:</label>
                    <input @bind=" newGameName" />
                </div>
                <div>
                    <label>Стоимость подарка до:</label>
                    <input @bind="giftCost" />
                </div>
            </div>
            <div class="header-bar right" style="margin-top:10px;display:block;">
                <button @onclick="CreateGameAsync">Создать</button>
                <button @onclick="ToggleCreateGameModal">Отмена</button>
            </div>
        </div>
    </div>
}

@if (selectedGame != null)
{
    <div class="modal-backdrop" @onclick="CloseGameModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h3>@selectedGame.Name</h3>

            <p>Участники:</p>
            <ol style="height: 150px;overflow-y:scroll;">
                @foreach (var participant in selectedGame.Participants)
                {
                    <li>@participant</li>
                }
            </ol>
            <hr />
            <p>Статус жеребьёвки: @(selectedGame.IsDrawn ? "Проведена" : "Не проведена")</p>
            @if (!selectedGame.IsDrawn)
            {
                <h4>Пожелания Санте</h4>
                <span contenteditable="true"
                      style="display: inline-block;
                             border: solid 1px black;max-width: 550px">
                </span>
                <div class="header-bar buttons" style="display:flex;justify-content:center">
                    <button>Добавить</button>
                </div>
            }
            else
            {
                <p>Получатель: @assgGifts.RecieverName</p>
                @foreach (var assg in assgGifts.RecieverGifts)
                {
                    <p style="margin-left:1.5em;">@assg.GiftName — @assg.DeliveryMethod</p>
                }
            }
            <h4>Мои желания</h4>
            <ul>
                @foreach (var gift in myGifts)
                {
                    <li style="display:flex;margin-bottom:0.5em;">
                        <div style="margin-right:1.5em;">
                            @gift.GiftName — @gift.DeliveryMethod
                        </div>

                        <button class="blue-button" @onclick="() => DeleteGiftAsync(gift.UserGiftId)"
                                style="margin-left:auto; color:white;">
                            ✖
                        </button>
                    </li>
                }
            </ul>

            <div style="margin-top:10px">
                <input placeholder="Название подарка" @bind="newGiftName" />
                <input placeholder="Способ передачи" @bind="newDeliveryMethod" />
                <button class="blue-button" @onclick="AddGiftAsync">Добавить</button>
            </div>
            @if (isCreator)
            {
                <div class="header-bar buttons">
                    @if (!selectedGame.IsDrawn)
                    {
                        <button @onclick="InviteParticipants">Пригласить участников</button>
                        <button style="margin:5px;" @onclick="StartDraw">Начать жеребьёвку</button>
                    }
                </div>
            }
            <div class="header-bar" style="display:flex;justify-content:center">
              <button @onclick="CloseGameModal">Закрыть</button>
            </div>
        </div>
    </div>
}
