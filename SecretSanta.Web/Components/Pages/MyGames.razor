@page "/mygames"
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JS
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager

<div class="hero">
    <div class="snowblock"></div>
    <div class="content">
        <h2>🎅 Тайный Санта не просто игра — это магия зимы! ❄️</h2>
        <p>Дарите радость, сюрпризы и тёплые эмоции друзьям!</p>
    </div>
</div>

<div class="container">
    @if (loading)
    {
        <p>Загрузка...</p>
    }
    else if (!isLoggedIn)
    {
        <p>Пожалуйста, войдите, чтобы видеть свои игры.</p>
    }
    else
    {
        @if (games?.Any() != true)
        {
            <p>У вас пока нет игр.</p>
        }
        else
        {
            <ul class="games-ul">
                @foreach (var game in games)
                {
                    <li class="games-li" @onclick="() => OpenGameModal(game)">
                        @game.Name (@game.CreatedAt.ToShortDateString())
                        — участников: @game.Participants.Count — стоимость подарка до @game.GiftCost
                        @if (game.IsDrawn)
                        {
                            <span style="color:green;"> (Жеребьёвка проведена)</span>
                        }
                        @if (@game.CreatorId == userId)
                        {
                            <span> — Создатель</span>
                        }
                        else
                        {
                            <span> — Участник</span>
                        }
                    </li>
                }
            </ul>
        }
        <div class="header-bar right" style="display:flex;justify-content:flex-end;">
            <button @onclick="ToggleCreateGameModal">Создать игру</button>
        </div>
    }
</div>

@if (showCreateGameModal)
{
    <div class="modal-backdrop" @onclick="ToggleCreateGameModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h3>Создать новую игру</h3>
            <div style="display:list-item;">
                <div style="margin-bottom:5px;">
                    <label>Название игры:</label>
                    <input @bind=" newGameName" />
                </div>
                <div>
                    <label>Стоимость подарка до:</label>
                    <input @bind="giftCost" />
                </div>
            </div>
            <div class="header-bar right" style="margin-top:10px;display:block;">
                <button @onclick="CreateGameAsync">Создать</button>
                <button @onclick="ToggleCreateGameModal">Отмена</button>
            </div>
        </div>
    </div>
}

@if (selectedGame != null)
{
    <div class="modal-backdrop" @onclick="CloseGameModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h3>@selectedGame.Name</h3>

            <p>Участники:</p>
            <ol style="height: 150px;overflow-y:scroll;">
                @foreach (var participant in selectedGame.Participants)
                {
                    <li>@participant</li>
                }
            </ol>
            <hr />
            <p>Статус жеребьёвки: @(selectedGame.IsDrawn ? "Проведена" : "Не проведена")</p>
            @if (!selectedGame.IsDrawn)
            {
                <h4>Пожелания Санте</h4>
                <span contenteditable="true"
                      style="display: inline-block;
                             border: solid 1px black;max-width: 550px">
                </span>
                <div class="header-bar buttons" style="display:flex;justify-content:center">
                    <button>Добавить</button>
                </div>
                <h4>Мои желания</h4>
                <ul>
                    @foreach (var gift in myGifts)
                    {
                        <li style="display:flex;margin-bottom:0.5em;">
                            <div style="margin-right:1.5em;">
                                @gift.GiftName — @gift.DeliveryMethod
                            </div>

                            <button class="blue-button" @onclick="() => DeleteGiftAsync(gift.UserGiftId)"
                                    style="margin-left:auto; color:white;">
                                ✖
                            </button>
                        </li>
                    }
                </ul>

                <div style="margin-top:10px">
                    <input placeholder="Название подарка" @bind="newGiftName" />
                    <input placeholder="Способ передачи" @bind="newDeliveryMethod" />
                    <button class="blue-button" @onclick="AddGiftAsync">Добавить</button>
                </div>
            }
            else
            {
                <p>Получатель: @assgGifts.RecieverName</p>
                <p>Желания: @myGiftName</p>
                @foreach (var assg in assgGifts.RecieverGifts)
                {
                    <p style="margin-left:1.5em;">@assg.GiftName — @assg.DeliveryMethod</p>
                }
                <h4>Мои желания</h4>
                <ul>
                    @foreach (var gift in myGifts)
                    {
                        <li style="display:flex;margin-bottom:0.5em;">
                            <div style="margin-right:1.5em;">
                                @gift.GiftName — @gift.DeliveryMethod
                            </div>

                            <button class="blue-button" @onclick="() => DeleteGiftAsync(gift.UserGiftId)"
                                    style="margin-left:auto; color:white;">
                                ✖
                            </button>
                        </li>
                    }
                </ul>

                <div style="margin-top:10px">
                    <input placeholder="Название подарка" @bind="newGiftName" />
                    <input placeholder="Способ передачи" @bind="newDeliveryMethod" />
                    <button class="blue-button" @onclick="AddGiftAsync">Добавить</button>
                </div>
            }
            @if (isCreator)
            {
                <div class="header-bar buttons">
                    @if (!selectedGame.IsDrawn)
                    {
                        <button @onclick="InviteParticipants">Пригласить участников</button>
                        <button style="margin:5px;" @onclick="StartDraw">Начать жеребьёвку</button>
                    }
                </div>
            }
            <div class="header-bar" style="display:flex;justify-content:center">
              <button @onclick="CloseGameModal">Закрыть</button>
            </div>
        </div>
    </div>
}

@code {
    private GameListDto? selectedGame;
    private bool isCreator = false;
    private string myGiftName = string.Empty;
    private string receiverName = string.Empty;
    private string giftDeliveryMethod = string.Empty;
    private List<UserGiftDto> myGifts = new();
    private RecieverGiftDto assgGifts = new();
    private string newGiftName = string.Empty;
    private string newDeliveryMethod = string.Empty;

    public class UserGiftDto
    {
        public int UserGiftId { get; set; }
        public string GiftName { get; set; } = null!;
        public string DeliveryMethod { get; set; } = null!;
    }

    public class RecieverGiftDto
    {
        public string RecieverName { get; set; }
        public List<UserGiftDto> RecieverGifts { get; set; } = new();
    }

    public class GameListDto
    {
        public int GameId { get; set; }
        public string Name { get; set; } = null!;
        public DateTime CreatedAt { get; set; }
        public bool IsDrawn { get; set; }
        public bool IsAnonymous { get; set; }
        public int CreatorId { get; set; }
        public int GiftCost { get; set; }
        public List<string> Participants { get; set; } = new();
    }

    private class InviteResult
    {
        public string InviteToken { get; set; } = string.Empty;
    }

    public class CreateGameRequest
    {
        public string Name { get; set; } = null!;
        public int GiftCost { get; set; }
    }

    public class MyGiftDto
    {
        public string GiftName { get; set; } = string.Empty;
        public string ReceiverName { get; set; } = string.Empty;
        public string DeliveryMethod { get; set; } = string.Empty;
    }

    private bool loading = true;
    private bool isLoggedIn = false;
    private int userId;
    private string token = string.Empty;
    private List<GameListDto> games = new();

    private bool showCreateGameModal = false;
    private string newGameName = string.Empty;
    private int giftCost = 1000;

    // Загрузка страницы
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        string userIdStr = string.Empty;
        if (firstRender)
        {
            try
            {
                token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
                userIdStr = await JS.InvokeAsync<string>("localStorage.getItem", "userId");
            }
            catch (Exception) {}

            isLoggedIn = !string.IsNullOrEmpty(token) && !string.IsNullOrEmpty(userIdStr);
            if (isLoggedIn)
                userId = int.Parse(userIdStr);

            if (!string.IsNullOrEmpty(inviteToken))
            {
                if (!isLoggedIn)
                {
                    try
                    {
                        await JS.InvokeVoidAsync("alert", "Для присоединения к игре необходимо войти или зарегистрироваться");
                    }
                    catch (Exception)
                    {

                    }
                }
                else
                {
                    await JoinGameByInviteTokenAsync(inviteToken);
                }
            }

            if (isLoggedIn)
                await LoadGamesAsync();

            loading = false;
            StateHasChanged();
        }
    }

    // Загрузка собственных подарков к игре
    private async Task LoadMyGiftsAsync(int gameId)
    {
        if (string.IsNullOrEmpty(token)) return;

        var client = ClientFactory.CreateClient("api");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var gifts = await client.GetFromJsonAsync<List<UserGiftDto>>($"http://apiservice/api/Gifts/{gameId}/gifts");
        if (gifts != null)
            myGifts = gifts;
    }

    // Добавление подарка к игре
    private async Task AddGiftAsync()
    {
        if (selectedGame == null || string.IsNullOrWhiteSpace(newGiftName) || string.IsNullOrWhiteSpace(newDeliveryMethod))
            return;

        var client = ClientFactory.CreateClient("api");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var dto = new UserGiftDto
        {
            GiftName = newGiftName,
            DeliveryMethod = newDeliveryMethod
        };

        var response = await client.PostAsJsonAsync($"http://apiservice/api/Gifts/{selectedGame.GameId}/gifts", dto);
        if (response.IsSuccessStatusCode)
        {
            newGiftName = string.Empty;
            newDeliveryMethod = string.Empty;
            await LoadMyGiftsAsync(selectedGame.GameId);
            StateHasChanged();
        }
        else
        {
            try
            {
                var error = await response.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("alert", $"Возникла ошибка: {error}");
            } catch (Exception) { }
        }
    }

    // Удаление подарка из игры
    private async Task DeleteGiftAsync(int giftId)
    {
        var client = ClientFactory.CreateClient("api");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var response = await client.DeleteAsync(
            $"http://apiservice/api/gifts/{selectedGame.GameId}/gifts/{giftId}");

        if (response.IsSuccessStatusCode)
        {
            var item = myGifts.FirstOrDefault(x => x.UserGiftId == giftId);
            if (item != null)
            {
                myGifts.Remove(item);
                StateHasChanged();
            }
        }
        else
        {
            try
            {
                var error = await response.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("alert", $"Возникла ошибка: {error}");
            }
            catch (Exception) { }
        }
    }

    // Загрузка игр при входе на страницу
    private async Task LoadGamesAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("api");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var response = await client.GetFromJsonAsync<List<GameListDto>>($"http://apiservice/api/games/user/{userId}");
            if (response != null)
                games = response;
        }
        catch
        {
            games = new List<GameListDto>();
        }
    }

    private void ToggleCreateGameModal() => showCreateGameModal = !showCreateGameModal;

    private async Task CreateGameAsync()
    {
        if (string.IsNullOrWhiteSpace(newGameName)) return;

        var client = ClientFactory.CreateClient("api");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var content = JsonContent.Create(new CreateGameRequest { Name = newGameName, GiftCost = giftCost });
        var response = await client.PostAsync($"http://apiservice/api/games?creatorUserId={userId}", content);


        if (response.IsSuccessStatusCode)
        {
            newGameName = string.Empty;
            showCreateGameModal = false;
            await LoadGamesAsync(); // Обновляем список
            StateHasChanged();
        }
        else
        {
            try
            {
                var error = await response.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("alert", $"Ошибка создания игры: {error}");
            }
            catch (Exception) { }
        }
    }

    // Открытие игры в модальном окне
    private async void OpenGameModal(GameListDto game)
    {
        selectedGame = game;
        isCreator = game.CreatorId == userId;

        if (game.IsDrawn)
        {
            await LoadReceiverAssignmentAsync(game.GameId);
            await LoadMyGiftsAsync(game.GameId);
        }
        else
        {
            await LoadMyGiftsAsync(game.GameId);
        }

        StateHasChanged();
    }

    // Закрытие окна с игрой
    private void CloseGameModal()
    {
        selectedGame = null;
    }

    // Получение списка подарков получателя
    private async Task LoadReceiverAssignmentAsync(int gameId)
    {
        if (string.IsNullOrEmpty(token)) return;

        var client = ClientFactory.CreateClient("api");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

        try
        {
            var result = await client.GetFromJsonAsync<RecieverGiftDto>($"http://apiservice/api/Assignments/giver/{gameId}/{userId}");
            if (result != null)
            {
                assgGifts = result;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки подарка после жеребьёвки: {ex.Message}");
        }
    }

    // Старт жеребьевки
    private async Task StartDraw()
    {
        var client = ClientFactory.CreateClient("api");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var response = await client.PostAsync($"http://apiservice/api/Assignments/draw/{selectedGame!.GameId}", null);
        if (response.IsSuccessStatusCode)
        {
            await LoadGamesAsync();
            selectedGame.IsDrawn = true;
            await LoadReceiverAssignmentAsync(selectedGame.GameId);
        }
        else
        {
            try
            {
                var error = await response.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("alert", $"Возникла ошибка при начале жеребьевки: {error}");
            }
            catch (Exception) {}
        }
    }

    // Загрузка собственных подарков к игре
    private async Task LoadMyGiftAsync(int gameId)
    {
        var client = ClientFactory.CreateClient("api");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var result = await client.GetFromJsonAsync<MyGiftDto>($"http://apiservice/api/Gifts/{gameId}/myassignment");
        if (result != null)
        {
            myGiftName = result.GiftName;
            receiverName = result.ReceiverName;
            giftDeliveryMethod = result.DeliveryMethod;
        }
    }

    // Приглашие участников в игру
    private async Task InviteParticipants()
    {
        if (selectedGame == null) return;

        var client = ClientFactory.CreateClient("api");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var response = await client.PostAsync($"http://apiservice/api/games/{selectedGame.GameId}/invite", null);
        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<InviteResult>();
            if (result != null)
            {
                var inviteLink = $"{NavigationManager.Uri}?inviteToken={result.InviteToken}";
                try
                {
                    await JS.InvokeVoidAsync("alert", $"Ссылка для приглашения участников: {inviteLink}");
                }
                catch (Exception) {}
            }
        }
    }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? inviteToken { get; set; }

    // Присоединение к игре по приглашению
    private async Task JoinGameByInviteTokenAsync(string token)
    {
        try
        {
            var client = ClientFactory.CreateClient("api");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", this.token);

            var response = await client.PostAsync($"http://apiservice/api/games/join/{token}", null);
            if (response.IsSuccessStatusCode)
            {
                await LoadGamesAsync(); // Обновляем список игр
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("alert", $"Не удалось присоединиться к игре: {error}");
            }
        }
        catch (Exception)
        {
        }
    }
    private class ReceiverAssignmentDto
    {
        public string ReceiverDisplayName { get; set; } = string.Empty;
        public string GiftName { get; set; } = string.Empty;
        public string DeliveryMethod { get; set; } = string.Empty;
    }
}

