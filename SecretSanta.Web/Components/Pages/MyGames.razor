@page "/mygames"
@using SecretSanta.Web.Localization
@inject IStringLocalizer<SharedResource> Localizer
<PageTitle>@Localizer["MyGames"]</PageTitle>
<section class="page-section"><div class="shell">
  <div class="page-heading"><div><p class="eyebrow">@Localizer["PersonalSpace"]</p><h1>@Localizer["MyGames"]</h1><p>@Localizer["MyGamesIntro"]</p></div>@if(isLoggedIn){<button class="btn btn-primary" @onclick="OpenCreate">＋ @Localizer["CreateGame"]</button>}</div>
  @if(!string.IsNullOrEmpty(notice)){<div class="notice @(noticeError?"notice-error":"notice-success")" role="status">@notice</div>}
  @if(loading){<div class="loading-state"><span class="spinner"></span><p>@Localizer["LoadingGames"]</p></div>}
  else if(!isLoggedIn){<div class="empty-state"><div class="mini-envelope"></div><h2>@Localizer["SignInToSeeGames"]</h2><p>@Localizer["SignInGamesHint"]</p></div>}
  else if(loadFailed){<div class="empty-state"><h2>@Localizer["GamesLoadFailed"]</h2><p>@Localizer["ConnectionError"]</p><button class="btn btn-secondary" @onclick="LoadGamesAsync">@Localizer["TryAgain"]</button></div>}
  else if(games.Count==0){<div class="empty-state"><div class="mini-envelope"></div><h2>@Localizer["NoGames"]</h2><p>@Localizer["NoGamesHint"]</p><button class="btn btn-primary" @onclick="OpenCreate">@Localizer["CreateFirstGame"]</button></div>}
  else {<div class="games-toolbar"><span>@UiText.ParticipantCount(Localizer,games.Count)</span><span class="legend"><i></i>@Localizer["ActiveGames"]</span></div><div class="game-grid">@foreach(var game in games){<a class="game-card" href="@($"/games/{game.GameId}")"><div class="card-ribbon"></div><div class="game-card-top"><span class="status-pill @(game.IsDrawn?"status-done":"status-open")">@(game.IsDrawn?Localizer["Completed"]:Localizer["CollectingParticipants"])</span><span class="arrow">↗</span></div><h2>@game.Name</h2><p class="game-date">@Localizer["CreatedOn",game.CreatedAt.ToString("d",System.Globalization.CultureInfo.CurrentCulture)]</p><div class="game-meta"><div><small>@Localizer["Participants"]</small><strong>@game.Participants.Count</strong></div><div><small>@Localizer["Budget"]</small><strong>@game.GiftCost.ToString("N0")</strong></div></div><div class="game-card-foot"><span>@(game.CreatorId==userId?Localizer["OrganizerRole"]:Localizer["ParticipantRole"])</span><span>@Localizer["OpenGame"] →</span></div></a>}</div>}
</div></section>
@if(showCreateGameModal){<div class="dialog-backdrop" @onpointerdown="CloseCreate"><section class="dialog" role="dialog" aria-modal="true" aria-labelledby="create-title" @onpointerdown:stopPropagation @onkeydown="HandleDialogKey"><button class="icon-button dialog-close" @onclick="CloseCreate" aria-label="@Localizer["Close"]">×</button><p class="eyebrow">@Localizer["NewTradition"]</p><h2 id="create-title">@Localizer["CreateNewGame"]</h2><p class="muted">@Localizer["CreateGameHint"]</p>@if(!string.IsNullOrEmpty(formError)){<div class="notice notice-error">@formError</div>}<EditForm Model="createModel" OnValidSubmit="CreateGameAsync" FormName="create-game"><DataAnnotationsValidator/><div class="field"><label for="game-name">@Localizer["GameName"]</label><InputText id="game-name" @bind-Value="createModel.Name" placeholder="@Localizer["GameNameExample"]" maxlength="200"/><ValidationMessage For="()=>createModel.Name"/></div><div class="field"><label for="budget">@Localizer["GiftCostUpTo"]</label><div class="input-suffix"><InputNumber id="budget" @bind-Value="createModel.GiftCost" min="0"/><span>₽</span></div><small>@Localizer["BudgetHint"]</small></div><div class="dialog-actions"><button type="button" class="btn btn-secondary" @onclick="CloseCreate">@Localizer["Cancel"]</button><button class="btn btn-primary" disabled="@saving">@(saving?Localizer["Saving"]:Localizer["CreateGame"])</button></div></EditForm></section></div>}
