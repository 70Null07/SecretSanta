@using SecretSanta.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SecretSanta</a>
    </div>
</div>

<input type="checkbox" title="@Localizer["NavigationMenu"]" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> @Localizer["Home"]
            </NavLink>
        </div>
    </nav>
</div>
