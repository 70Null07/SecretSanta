@inherits LayoutComponentBase
@rendermode InteractiveServer
@using System.Globalization
@using System.Net.Http.Json
@using SecretSanta.Web.Localization
@inject IStringLocalizer<SharedResource> Localizer
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JS
@inject NavigationManager Nav

<a class="skip-link" href="#main-content">@Localizer["SkipToContent"]</a>
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="@Localizer["AppName"]">
      <span class="brand-mark" aria-hidden="true"><span></span></span>
      <span>@Localizer["AppName"]</span>
    </a>
    <button class="menu-toggle" @onclick="() => menuOpen = !menuOpen" aria-expanded="@menuOpen" aria-label="@Localizer["NavigationMenu"]"><span></span><span></span><span></span></button>
    <nav class="primary-nav @(menuOpen ? "is-open" : null)" aria-label="@Localizer["NavigationMenu"]">
      <NavLink href="/" Match="NavLinkMatch.All">@Localizer["Home"]</NavLink>
      <NavLink href="/mygames">@Localizer["MyGames"]</NavLink>
    </nav>
    <div class="header-actions">
      <label class="visually-hidden" for="culture-select">@Localizer["Language"]</label>
      <select id="culture-select" class="language-select" value="@CultureInfo.CurrentUICulture.Name" @onchange="ChangeCulture">
        <option value="ru-RU">RU</option><option value="en-US">EN</option>
      </select>
      @if (isLoggedIn) {
        <details class="user-menu"><summary><span class="avatar">@Initial</span><span class="user-name">@currentUserName</span></summary>
          <div class="user-popover"><a href="/mygames">@Localizer["MyGames"]</a><button @onclick="LogoutAsync">@Localizer["SignOut"]</button></div>
        </details>
      } else { <button class="btn btn-secondary btn-small" @onclick="OpenAuth">@Localizer["SignIn"]</button> }
    </div>
  </div>
</header>

<main id="main-content">@Body</main>
<footer class="site-footer"><div class="shell"><span class="brand footer-brand"><span class="brand-mark" aria-hidden="true"><span></span></span>@Localizer["AppName"]</span><span>@Localizer["FooterText"]</span></div></footer>

@if (showAuth) {
  <div class="dialog-backdrop" @onpointerdown="CloseAuth">
    <section class="dialog auth-dialog" role="dialog" aria-modal="true" aria-labelledby="auth-title" @onpointerdown:stopPropagation @onkeydown="HandleDialogKey">
      <button class="icon-button dialog-close" @onclick="CloseAuth" aria-label="@Localizer["Close"]">×</button>
      <div class="auth-ribbon" aria-hidden="true"></div>
      <p class="eyebrow">@Localizer["PrivateAndSimple"]</p>
      <h2 id="auth-title">@(registerMode ? Localizer["RegisterTitle"] : Localizer["SignInTitle"])</h2>
      <p class="muted">@(registerMode ? Localizer["RegisterSubtitle"] : Localizer["SignInSubtitle"])</p>
      <div class="segmented" role="tablist"><button class="@(!registerMode ? "active" : null)" @onclick="() => SetMode(false)">@Localizer["SignIn"]</button><button class="@(registerMode ? "active" : null)" @onclick="() => SetMode(true)">@Localizer["Register"]</button></div>
      @if (!string.IsNullOrEmpty(authError)) { <div class="notice notice-error" role="alert">@authError</div> }
      <EditForm Model="auth" OnValidSubmit="SubmitAuthAsync" FormName="auth-form">
        <DataAnnotationsValidator />
        <div class="field"><label for="auth-name">@(registerMode ? Localizer["DisplayName"] : Localizer["Login"])</label><InputText id="auth-name" @bind-Value="auth.Identifier" autocomplete="username" /><ValidationMessage For="() => auth.Identifier" /></div>
        <div class="field"><label for="auth-password">@Localizer["Password"]</label><div class="password-field"><InputText id="auth-password" type="@(showPassword ? "text" : "password")" @bind-Value="auth.Password" autocomplete="@(registerMode ? "new-password" : "current-password")" /><button type="button" @onclick="() => showPassword = !showPassword" aria-label="@Localizer["ShowPassword"]">@(showPassword ? "—" : "◉")</button></div><ValidationMessage For="() => auth.Password" /><small>@(registerMode ? Localizer["PasswordHint"] : Localizer["LoginHint"])</small></div>
        <button class="btn btn-primary btn-block" disabled="@authBusy">@(authBusy ? Localizer["PleaseWait"] : registerMode ? Localizer["CreateAccount"] : Localizer["SignIn"])</button>
      </EditForm>
    </section>
  </div>
}

<div id="blazor-error-ui" role="alert">@Localizer["ConnectionLost"] <a href="" class="reload">@Localizer["Reload"]</a><button class="dismiss">×</button></div>

@code {
  private bool showAuth, registerMode, showPassword, authBusy, menuOpen, isLoggedIn;
  private string currentUserName = "", authError = "";
  private AuthModel auth = new();
  private string Initial => string.IsNullOrEmpty(currentUserName) ? "?" : currentUserName[..1].ToUpper(CultureInfo.CurrentCulture);
  protected override async Task OnAfterRenderAsync(bool first) { if (!first) return; try { var token=await JS.InvokeAsync<string?>("localStorage.getItem","authToken"); if(!string.IsNullOrEmpty(token)){ var c=ClientFactory.CreateClient("api"); c.DefaultRequestHeaders.Authorization=new("Bearer",token); if((await c.GetAsync("api/auth/validate")).IsSuccessStatusCode){currentUserName=await JS.InvokeAsync<string>("localStorage.getItem","username")??"";isLoggedIn=true;} else await ClearAuth(); } } catch {} StateHasChanged(); }
  private void OpenAuth(){showAuth=true;authError="";}
  private void CloseAuth()=>showAuth=false;
  private void SetMode(bool value){registerMode=value;authError="";}
  private void HandleDialogKey(KeyboardEventArgs e){if(e.Key=="Escape") CloseAuth();}
  private void ChangeCulture(ChangeEventArgs e){var culture=e.Value?.ToString()??"ru-RU";var u=new Uri(Nav.Uri);Nav.NavigateTo($"culture/set?culture={Uri.EscapeDataString(culture)}&redirectUri={Uri.EscapeDataString(u.PathAndQuery)}",true);}
  private async Task SubmitAuthAsync(){ if(authBusy)return; authBusy=true;authError="";try {var c=ClientFactory.CreateClient("api"); if(registerMode){var rr=await c.PostAsJsonAsync("api/auth/register",new{DisplayName=auth.Identifier,Password=auth.Password});if(!rr.IsSuccessStatusCode){authError=Localizer[await ApiErrorReader.ReadCodeAsync(rr)];return;}} var r=await c.PostAsJsonAsync("api/auth/login",new{Identifier=auth.Identifier,Password=auth.Password});if(!r.IsSuccessStatusCode){authError=Localizer[await ApiErrorReader.ReadCodeAsync(r)];return;}var result=await r.Content.ReadFromJsonAsync<LoginResult>();if(result is null){authError=Localizer["AuthError"];return;}await JS.InvokeVoidAsync("localStorage.setItem","authToken",result.Token);await JS.InvokeVoidAsync("localStorage.setItem","username",result.User.DisplayName);await JS.InvokeVoidAsync("localStorage.setItem","userId",result.User.UserId.ToString());Nav.NavigateTo(Nav.Uri,true);}catch{authError=Localizer["ConnectionError"];}finally{authBusy=false;}}
  private async Task LogoutAsync(){await ClearAuth();Nav.NavigateTo("/",true);}
  private async Task ClearAuth(){try{await JS.InvokeVoidAsync("localStorage.removeItem","authToken");await JS.InvokeVoidAsync("localStorage.removeItem","username");await JS.InvokeVoidAsync("localStorage.removeItem","userId");}catch{}isLoggedIn=false;}
  private sealed class AuthModel { [System.ComponentModel.DataAnnotations.Required] public string Identifier{get;set;}=""; [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.MinLength(8)] public string Password{get;set;}=""; }
  private sealed class LoginResult { public UserResult User{get;set;}=new();public string Token{get;set;}=""; }
  private sealed class UserResult {public int UserId{get;set;}public string DisplayName{get;set;}="";}
}
