POSTGRES_DB=secretsanta
POSTGRES_USER=secretsanta
POSTGRES_PASSWORD=

JWT__KEY=
JWT__ISSUER=SecretSanta
JWT__AUDIENCE=SecretSantaUsers
JWT__EXPIRESMINUTES=60

WEB_PORT=8080

# Production only. Copy deploy/secrets.example to this directory, remove the
# .example suffixes and set permissions to 0600. Never place it inside the repo.
SECRETS_DIR=/opt/secretsanta/secrets
APP_VERSION=latest
BACKUP_DIR=/opt/secretsanta/backups
