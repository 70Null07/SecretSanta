# Install with: crontab ops/secretsanta-backup.cron
# Set explicit paths because cron does not inherit an interactive shell environment.
0 */6 * * * cd /opt/secretsanta/app && /usr/bin/env BACKUP_DIR=/opt/secretsanta/backups BACKUP_RETENTION_DAYS=14 /opt/secretsanta/app/ops/backup-postgres.sh >> /var/log/secretsanta-backup.log 2>&1
